#version 450

// Temporal anti-aliasing (§13, render::taa): this frame's jittered image
// blended into a history that follows the camera. render::taa's `reference`
// is this, step for step, on the CPU.

layout(local_size_x = 8, local_size_y = 8) in;

// This frame's resolved HDR image, read with texelFetch.
layout(set = 0, binding = 0) uniform sampler2D u_current;
// Its single-sample depth (the prepass's, or its resolve).
layout(set = 0, binding = 1) uniform sampler2D u_depth;
// Last frame's output, sampled bilinearly (linear, clamp to edge).
layout(set = 0, binding = 2) uniform sampler2D u_history;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D u_out;
// Auto-exposure's state (render::exposure's `State`): only `exposure` is read.
layout(std430, set = 0, binding = 4) readonly buffer State {
    uint histogram[256];
    float adapted;
    float exposure;
} state;

// Must match render::taa's `TaaPush::floats`.
layout(push_constant) uniform Push {
    // This frame's clip space (unjittered) to last frame's.
    mat4 reproject;
    // x = 1 when the history holds last frame, y = exposure (compensation
    // when z = 1: auto exposure).
    vec4 params;
} pc;

// Must match render::taa's reference (a test checks).
const float TAA_ALPHA = 0.1;
const float TAA_GAMMA = 1.0;

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Exposed colour over 1 + its luma: bounded, so a lone bright sample weighs
// as much as a bright one, not thousands of times more.
vec3 compress(vec3 c, float exposure) {
    vec3 s = max(c, vec3(0.0)) * exposure;
    return s / (1.0 + luma(s));
}

vec3 expand(vec3 t, float exposure) {
    return t / max(1.0 - luma(t), 1e-4) / exposure;
}

vec3 to_ycocg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 from_ycocg(vec3 y) {
    return vec3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z);
}

// `h` pulled towards `mean` onto the box of half-size `extent` round it, if
// outside; unchanged inside.
vec3 clip_to_box(vec3 h, vec3 mean, vec3 extent) {
    vec3 v = h - mean;
    vec3 units = abs(v / max(extent, vec3(1e-5)));
    float m = max(units.x, max(units.y, units.z));
    return m > 1.0 ? mean + v / m : h;
}

// Catmull-Rom weights for a tap `f` in [0, 1) past texel 1 of 0..3.
vec4 catmull_rom_weights(float f) {
    return vec4(f * (-0.5 + f * (1.0 - 0.5 * f)),
                1.0 + f * f * (-2.5 + 1.5 * f),
                f * (0.5 + f * (2.0 - 1.5 * f)),
                f * f * (-0.5 + 0.5 * f));
}

// A bicubic Catmull-Rom sample of the history at `uv` in five bilinear taps
// (the corner ones left out, the rest renormalised).
vec3 catmull_rom(vec2 uv) {
    vec2 size = vec2(textureSize(u_history, 0));
    vec2 q = uv * size;
    vec2 t1 = floor(q - 0.5) + 0.5;
    vec2 f = q - t1;
    vec4 wx = catmull_rom_weights(f.x);
    vec4 wy = catmull_rom_weights(f.y);
    vec2 w12 = vec2(wx.y + wx.z, wy.y + wy.z);
    vec2 t0 = (t1 - 1.0) / size;
    vec2 t3 = (t1 + 2.0) / size;
    vec2 t12 = (t1 + vec2(wx.z, wy.z) / w12) / size;
    vec3 sum = texture(u_history, vec2(t12.x, t0.y)).rgb * (w12.x * wy.x)
             + texture(u_history, vec2(t0.x, t12.y)).rgb * (wx.x * w12.y)
             + texture(u_history, vec2(t12.x, t12.y)).rgb * (w12.x * w12.y)
             + texture(u_history, vec2(t3.x, t12.y)).rgb * (wx.w * w12.y)
             + texture(u_history, vec2(t12.x, t3.y)).rgb * (w12.x * wy.w);
    float weight = w12.x * wy.x + wx.x * w12.y + w12.x * w12.y + wx.w * w12.y + w12.x * wy.w;
    return sum / weight;
}

void main() {
    ivec2 size = imageSize(u_out);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    float exposure = pc.params.z > 0.0 ? state.exposure * pc.params.y : pc.params.y;

    // The neighbourhood: its moments in compressed YCoCg, and its nearest
    // depth.
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    ivec2 nearest = p;
    float nearest_depth = 2.0; // past any depth
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), size - 1);
            vec3 c = to_ycocg(compress(texelFetch(u_current, q, 0).rgb, exposure));
            m1 += c;
            m2 += c * c;
            float d = texelFetch(u_depth, q, 0).r;
            if (d < nearest_depth) {
                nearest = q;
                nearest_depth = d;
            }
        }
    }
    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    vec3 centre = to_ycocg(compress(texelFetch(u_current, p, 0).rgb, exposure));

    // Where the nearest texel was last frame: its motion, moved to p.
    vec2 ndc = (vec2(nearest) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec4 prev = pc.reproject * vec4(ndc, nearest_depth, 1.0);
    vec2 motion = prev.xy / prev.w - ndc;
    vec2 uv = (vec2(p) + 0.5) / vec2(size) + motion * 0.5;

    bool inside = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));
    vec3 result = centre;
    if (pc.params.x > 0.0 && inside) {
        vec3 h = to_ycocg(compress(catmull_rom(uv), exposure));
        h = clip_to_box(h, mean, sigma * TAA_GAMMA);
        result = mix(h, centre, TAA_ALPHA);
    }
    imageStore(u_out, p, vec4(expand(from_ycocg(result), exposure), 1.0));
}
