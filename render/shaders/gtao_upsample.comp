#version 450

// GTAO's upsample (§13): the denoised half-resolution result back to full
// resolution, for mesh.frag's texelFetch. Half-resolution texel h is
// full-resolution pixel 2h, so a pixel at even coordinates is its texel and
// copies it; any other lies between two or four texels, and blends them
// bilinearly, each weighted as the denoise weighs its neighbours, by its
// distance off the pixel's tangent plane. So on a plane it's a plain
// bilinear blend, and across a silhouette only the texels on the pixel's
// own surface count. If none is (a feature too thin to have a texel of its
// own), it takes the texel nearest in distance.
// render::ao's reference is this, step for step.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_depth;
// Half resolution in, full resolution out.
layout(set = 0, binding = 2, r32f) uniform readonly image2D u_half;
layout(set = 0, binding = 3, r32f) uniform writeonly image2D u_ao;

layout(push_constant) uniform Push {
    vec4 proj; // as gtao.comp's
    vec4 params;
} pc;

// gtao_denoise.comp's (a test checks).
const float AO_DENOISE_DEPTH = 0.1;

// The full-resolution depth's size.
ivec2 g_size;

// gtao.comp's, text for text (a test checks).
vec3 view_pos(ivec2 p) {
    p = clamp(p, ivec2(0), g_size - 1);
    float dist = pc.proj.x / (texelFetch(u_depth, p, 0).r + pc.proj.y);
    vec2 ndc = (vec2(p) + 0.5) / vec2(g_size) * 2.0 - 1.0;
    return vec3(ndc * pc.proj.zw * dist, dist);
}

// The surface normal at pixel `p` (position `P`), from the neighbours on
// whichever side is nearer in depth (so a silhouette edge doesn't bend it),
// facing the camera. At the image's edge, the side that's in it.
vec3 depth_normal(ivec2 p, vec3 P) {
    vec3 l = view_pos(p - ivec2(1, 0));
    vec3 r = view_pos(p + ivec2(1, 0));
    vec3 u = view_pos(p - ivec2(0, 1));
    vec3 d = view_pos(p + ivec2(0, 1));
    bool right = p.x == 0 || (p.x < g_size.x - 1 && abs(r.z - P.z) < abs(P.z - l.z));
    bool down = p.y == 0 || (p.y < g_size.y - 1 && abs(d.z - P.z) < abs(P.z - u.z));
    vec3 dx = right ? r - P : P - l;
    vec3 dy = down ? d - P : P - u;
    return normalize(cross(dy, dx));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    g_size = textureSize(u_depth, 0);
    if (p.x >= g_size.x || p.y >= g_size.y) {
        return;
    }
    if (texelFetch(u_depth, p, 0).r >= 1.0) {
        imageStore(u_ao, p, vec4(1.0));
        return;
    }
    vec3 P = view_pos(p);
    vec3 N = depth_normal(p, P);
    float tolerance = AO_DENOISE_DEPTH * P.z;
    ivec2 half_size = imageSize(u_half);
    ivec2 q0 = p >> 1;
    // How far p lies towards the next texel: 0 or 1/2 on each axis.
    vec2 f = vec2(p & 1) * 0.5;
    float sum = 0.0;
    float total = 0.0;
    float nearest = 1.0;
    float nearest_dz = 1e30;
    for (int y = 0; y <= 1; ++y) {
        for (int x = 0; x <= 1; ++x) {
            float bilinear = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
            if (bilinear == 0.0) {
                continue;
            }
            ivec2 q = min(q0 + ivec2(x, y), half_size - 1);
            vec3 Q = view_pos(2 * q);
            float ao = imageLoad(u_half, q).r;
            float w = bilinear * max(1.0 - abs(dot(Q - P, N)) / tolerance, 0.0);
            sum += w * ao;
            total += w;
            float dz = abs(Q.z - P.z);
            if (dz < nearest_dz) {
                nearest_dz = dz;
                nearest = ao;
            }
        }
    }
    imageStore(u_ao, p, vec4(total > 1e-4 ? sum / total : nearest));
}
