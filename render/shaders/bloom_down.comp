#version 450

// Bloom downsample (§13, Jimenez 2014): one level of the bloom chain from the
// level above it, or from the HDR image for the first. The 13-tap filter is
// five overlapping 2x2 boxes: the centre box weighted BOX_CENTRE, the four
// corner boxes BOX_CORNER each (weights sum to 1). Taps sit between texels,
// so each bilinear fetch averages four.
//
// The first step weights each box by 1 / (1 + luma) and renormalises (the
// Karis average): a single very bright pixel then can't dominate the chain
// and flicker the whole bloom as it moves.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_dst;

layout(push_constant) uniform Push {
    vec2 src_texel; // 1 / the source's size
    uint karis;     // 1 on the first step
} pc;

// Must match render::bloom's reference (a test checks).
const float BOX_CENTRE = 0.5;
const float BOX_CORNER = 0.125;

vec3 tap(vec2 uv, float x, float y) {
    return texture(u_src, uv + vec2(x, y) * pc.src_texel).rgb;
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_dst);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(size);

    vec3 a = tap(uv, -2.0, 2.0), b = tap(uv, 0.0, 2.0), c = tap(uv, 2.0, 2.0);
    vec3 d = tap(uv, -2.0, 0.0), e = tap(uv, 0.0, 0.0), f = tap(uv, 2.0, 0.0);
    vec3 g = tap(uv, -2.0, -2.0), h = tap(uv, 0.0, -2.0), i = tap(uv, 2.0, -2.0);
    vec3 j = tap(uv, -1.0, 1.0), k = tap(uv, 1.0, 1.0);
    vec3 l = tap(uv, -1.0, -1.0), m = tap(uv, 1.0, -1.0);

    vec3 boxes[5] = vec3[5](
        (j + k + l + m) * 0.25,
        (a + b + d + e) * 0.25,
        (b + c + e + f) * 0.25,
        (d + e + g + h) * 0.25,
        (e + f + h + i) * 0.25
    );
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int n = 0; n < 5; n++) {
        float w = n == 0 ? BOX_CENTRE : BOX_CORNER;
        if (pc.karis != 0u) {
            w /= 1.0 + luma(boxes[n]);
        }
        sum += boxes[n] * w;
        total += w;
    }
    imageStore(u_dst, p, vec4(sum / total, 1.0));
}
