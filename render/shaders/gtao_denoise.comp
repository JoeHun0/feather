#version 450

// GTAO's denoise (§13): a 4x4 blur of gtao.comp's output, which holds each of
// its 16 jitter variants exactly once, so on a smooth surface the noise
// averages away completely. Surface-aware: a neighbour counts less the
// further it lies off the centre's tangent plane, and not at all past
// AO_DENOISE_DEPTH of the centre's distance, so occlusion doesn't bleed
// across silhouettes. On a plane every weight is 1, which keeps the average
// even: weighting by depth difference instead favoured some jitter variants
// over others on a receding floor, 4% dark at the worst pixel.
// render::ao's reference is this, step for step.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_depth;
layout(set = 0, binding = 1, r32f) uniform readonly image2D u_raw;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D u_ao;

layout(push_constant) uniform Push {
    vec4 proj; // as gtao.comp's
    vec4 params;
} pc;

// Must match render::ao's reference (a test checks).
const float AO_DENOISE_DEPTH = 0.1;

ivec2 g_size;

// gtao.comp's, text for text (a test checks).
vec3 view_pos(ivec2 p) {
    p = clamp(p, ivec2(0), g_size - 1);
    float dist = pc.proj.x / (texelFetch(u_depth, p, 0).r + pc.proj.y);
    vec2 ndc = (vec2(p) + 0.5) / vec2(g_size) * 2.0 - 1.0;
    return vec3(ndc * pc.proj.zw * dist, dist);
}

// The surface normal at pixel `p` (position `P`), from the neighbours on
// whichever side is nearer in depth (so a silhouette edge doesn't bend it),
// facing the camera. At the image's edge, the side that's in it.
vec3 depth_normal(ivec2 p, vec3 P) {
    vec3 l = view_pos(p - ivec2(1, 0));
    vec3 r = view_pos(p + ivec2(1, 0));
    vec3 u = view_pos(p - ivec2(0, 1));
    vec3 d = view_pos(p + ivec2(0, 1));
    bool right = p.x == 0 || (p.x < g_size.x - 1 && abs(r.z - P.z) < abs(P.z - l.z));
    bool down = p.y == 0 || (p.y < g_size.y - 1 && abs(d.z - P.z) < abs(P.z - u.z));
    vec3 dx = right ? r - P : P - l;
    vec3 dy = down ? d - P : P - u;
    return normalize(cross(dy, dx));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    g_size = textureSize(u_depth, 0);
    if (p.x >= g_size.x || p.y >= g_size.y) {
        return;
    }
    if (texelFetch(u_depth, p, 0).r >= 1.0) {
        imageStore(u_ao, p, vec4(1.0));
        return;
    }
    vec3 P = view_pos(p);
    vec3 N = depth_normal(p, P);
    float tolerance = AO_DENOISE_DEPTH * P.z;
    float sum = 0.0;
    float total = 0.0;
    for (int y = -1; y <= 2; ++y) {
        for (int x = -1; x <= 2; ++x) {
            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), g_size - 1);
            float off = abs(dot(view_pos(q) - P, N));
            float w = max(1.0 - off / tolerance, 0.0);
            sum += w * imageLoad(u_raw, q).r;
            total += w;
        }
    }
    imageStore(u_ao, p, vec4(min(sum / total, 1.0)));
}
