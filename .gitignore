/target
/scratch/
# Python bytecode (tools/gen_naturescene.py imports gen_testscene)
__pycache__/
# Personal settings, created on first run (app/src/config/)
# weather.json is the exception: the weather key tables are shipped data
# (§13), not personal settings. The *contents* are ignored (not the
# directory), so the file can be re-included.
/config/*
!/config/weather.json
